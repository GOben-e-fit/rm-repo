# --- Auth (Keycloak OIDC) ---
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_KEYCLOAK_ID=operator-ui
AUTH_KEYCLOAK_SECRET=replace-from-keycloak-client
AUTH_KEYCLOAK_ISSUER=https://keycloak.ben-e-fit.ai/realms/ben-e-fit
AUTH_TRUST_HOST=true

# --- DB (Postgres) ---
# Phase 1: lokales Postgres oder DGX-internal Postgres-Container
DATABASE_URL=postgresql://operator:CHANGE_ME@localhost:5432/operator_ui?schema=public

# --- Plugin Manager Service ---
PLUGIN_MANAGER_BASE_URL=http://plugin-manager:4000
PLUGIN_MANAGER_API_KEY=replace-with-shared-secret

# --- DGX SSH Bridge (Phase 1 read-only) ---
DGX_SSH_HOST=dgx-spark
DGX_SSH_USER=admin
# Bevorzugt: SSH-Key, kein Passwort
DGX_SSH_KEY_PATH=/run/secrets/operator-ui-ssh-key

# --- Anthropic (für Phase 6 Computer Use) ---
ANTHROPIC_API_KEY=

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=RM-KI Operator UI
