# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Auth: shared secret with rm-ki-operator-ui (and OWUI tool-server) ---
PLUGIN_MANAGER_API_KEY=replace-with-shared-secret-32-bytes

# --- DB (Postgres) ---
DATABASE_URL=postgresql://plugin_mgr:CHANGE_ME@localhost:5432/plugin_manager?schema=public

# --- Audit-Sinks (optional in Phase 2 — können erst leer bleiben) ---
OPENSEARCH_URL=
OPENSEARCH_INDEX=mcp-tool-invocations
OPENSEARCH_AUTH=

PAPERCLIP_EVIDENCE_BRIDGE_URL=
PAPERCLIP_EVIDENCE_BRIDGE_KEY=

# --- Dify (Fallback-Dispatcher) ---
DIFY_BASE_URL=
DIFY_API_KEY=

# --- MCP Server endpoints (kommagetrennt, oder pro Tenant in DB) ---
# Beispiel-Format:  github=https://mcp.github.example.com,stripe=stdio:./mcp-stripe
MCP_BUILTIN_ENDPOINTS=
